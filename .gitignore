# =====================================================
# xhs-note-creator .gitignore
# 目的：保护凭据、忽略构建产物、保持仓库整洁
# =====================================================

# ---- 安全：凭据与本地配置 ----
# 严禁提交任何包含真实 Cookie / Token 的文件
.env
.env.*
!.env.example
*.env.local
*.env.production
*.env.development

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
build/
dist/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
.installed.cfg
MANIFEST

# 虚拟环境
venv/
env/
ENV/
.venv/
env.bak/
venv.bak/
.python-version

# 测试 / 缓存
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.cache
.mypy_cache/
.ruff_cache/
.pyre/

# ---- Node.js ----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/
.yarn-integrity
package-lock.json.bak

# Playwright 浏览器缓存
.playwright/
playwright/.cache/
playwright-report/
test-results/

# ---- 渲染输出（用户生成的图片） ----
# 渲染脚本默认输出到工作目录
# 如果用户在仓库内运行渲染，可临时忽略产物
/output/
/renders/
*.tmp.png

# ---- IDE / 编辑器 ----
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/
nbproject/
nbbuild/
nbdist/

# ---- 操作系统 ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ---- 日志 ----
*.log
logs/

# ---- 临时文件 ----
*.tmp
*.bak
*.swp
*.swo
*~
.directory
.Trash-*

# ---- 杂项 ----
*.local
.history/